# Copy to .env for local runs. Never commit real keys.

# Meta Model API (dev.meta.ai). Leave empty until you have credits: /api/vision then returns 503
# but the safety check and hospital list still run.
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
MUSE_SPARK_MODELS=muse-spark-1.3,muse-spark-1.2,muse-spark-1.1
SAM_MODEL=sam-3.1
VOICE_MODEL=muse-voice-transcribe-1.0
VOICE_LANGUAGE_BIAS=Hindi,English

# Matrix companion app
MATRIX_API_BASE=https://matrix.hospitalsofnepal.com
MATRIX_HOSPITAL_URL=https://matrix.hospitalsofnepal.com/#/h/{id}
MATRIX_CACHE_SECONDS=600

# Auth: "firebase" (production) or "dev" (local: token "dev:<uid>" is accepted)
AUTH_MODE=dev
FIREBASE_PROJECT_ID=projects-4e426
# Optional; read from Matrix /api/config when empty. Public values, not secrets.
FIREBASE_WEB_CONFIG=
# "firestore" or "memory"
STORE=memory

DAILY_VISION_LIMIT=10
DAILY_QUESTION_LIMIT=30
PUBLIC_ORIGIN=https://matrixvision.hospitalsofnepal.com
